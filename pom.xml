<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.phase4</groupId>
        <artifactId>15soat-phase4-lib-commons</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../15soat-phase4-lib-commons/pom.xml</relativePath>
    </parent>

    <groupId>br.com.fiap.phase4</groupId>
    <artifactId>15soat-phase4-api-exec</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>15soat-phase4-api-exec</name>
    <description>Workshop Execution and Production Microservice (MongoDB + Kafka)</description>

    <modules>
        <module>domain</module>
        <module>application</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.0.7</spring-boot.version>
        <commons.version>0.0.1-SNAPSHOT</commons.version>
        <openapi-generator-maven-plugin.version>7.12.0</openapi-generator-maven-plugin.version>
        <jackson-databind-nullable.version>0.2.6</jackson-databind-nullable.version>
        <swagger-annotations.version>2.2.28</swagger-annotations.version>
        <archunit.version>1.4.1</archunit.version>
        <testcontainers.version>1.20.5</testcontainers.version>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-domain</artifactId>
                <version>${commons.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-web</artifactId>
                <version>${commons.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-kafka</artifactId>
                <version>${commons.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-mongo</artifactId>
                <version>${commons.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                </plugin>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>0.10.6</version>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
